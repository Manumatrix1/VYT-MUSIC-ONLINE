rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== REGLAS PARA USUARIOS =====
    match /users/{userId} {
      // Los usuarios pueden leer y escribir solo sus propios datos
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Los admins pueden leer todos los usuarios
      allow read: if isAdmin();
      
      // Permitir creación de nuevos usuarios autenticados
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Permitir acceso básico para login (lectura temporal)
      allow read: if request.auth != null;
    }
    
    // ===== REGLAS PARA PERFILES DE ARTISTAS =====
    match /artist_profiles/{profileId} {
      // Los artistas pueden gestionar su propio perfil
      allow read: if true; // Perfiles públicos
      allow write: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || isAdmin());
      
      // Permitir creación si es el usuario autenticado
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
        
      // Permitir lectura para usuarios autenticados
      allow read: if request.auth != null;
    }
    
    // ===== REGLAS PARA CERTÁMENES =====
    match /certamenes_provinciales/{certamenId} {
      // Lectura pública de certámenes activos
      allow read: if true;
      
      // Solo admins pueden crear/modificar certámenes
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA PARTICIPANTES ONLINE =====
    match /participantes_online/{participanteId} {
      // PERMITIR INSCRIPCIONES SIN AUTENTICACIÓN
      // Los usuarios pueden crear inscripciones libremente (registro público)
      allow create: if validateInscripcionData();
      
      // Los usuarios autenticados pueden leer su propia participación
      allow read: if request.auth != null && 
        (resource.data.uid == request.auth.uid || isAdmin());
        
      // Permitir lectura pública para mostrar participantes (si es necesario)
      allow read: if isAdmin();
      
      // Solo admins pueden modificar participaciones
      allow update: if isAdmin();
    }
    
    // ===== REGLAS PARA TESTS (TEMPORAL) =====
    match /tests/{docId} {
      allow read, write, create, delete: if isAdmin(); // Solo admins pueden acceder
    }
    
    match /test_conexion/{docId} {
      allow create: if isAdmin(); // Solo admins pueden crear tests
    }
    
    match /test_inscripciones/{docId} {
      allow create: if isAdmin(); // Solo admins pueden crear tests
    }
    
    // ===== REGLAS PARA PARTICIPANTES PRESENCIALES =====
    match /participantes_presencial/{participanteId} {
      allow read: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || isAdmin());
      
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
      
      allow update: if isAdmin();
    }
    
    // ===== REGLAS PARA VOTOS =====
    match /votes/{voteId} {
      // Los usuarios pueden leer sus propios votos
      allow read: if request.auth != null && 
        resource.data.voter_id == request.auth.uid;
      
      // Los admins pueden leer todos los votos
      allow read: if isAdmin();
      
      // Los usuarios autenticados pueden crear votos
      allow create: if request.auth != null && 
        request.resource.data.voter_id == request.auth.uid &&
        validateVoteData();
      
      // Los votos no se pueden modificar
      allow update: if false;
    }
    
    // ===== REGLAS PARA TRANSACCIONES VYT-MONEY =====
    match /vyt_money_transactions/{transactionId} {
      // Los usuarios pueden leer sus propias transacciones
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      
      // Los admins pueden leer todas las transacciones
      allow read: if isAdmin();
      
      // Solo el sistema puede crear transacciones (via Cloud Functions)
      allow create: if false;
      allow update: if false;
    }
    
    // ===== REGLAS PARA TRANSACCIONES DE PAGO =====
    match /payment_transactions/{transactionId} {
      // Los usuarios pueden leer sus propias transacciones
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      
      // Los admins pueden leer todas las transacciones
      allow read: if isAdmin();
      
      // Solo el sistema puede gestionar transacciones
      allow create, update: if false;
    }
    
    // ===== REGLAS PARA CONFIGURACIÓN DE PAGOS =====
    match /payment_config/{configId} {
      // Lectura pública de configuración
      allow read: if true;
      
      // Solo admins pueden modificar configuración
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA CONFIGURACIÓN VYT-MONEY =====
    match /vyt_money_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA RANKINGS =====
    match /rankings/{rankingId} {
      // Lectura pública de rankings
      allow read: if true;
      
      // Solo el sistema puede actualizar rankings
      allow write: if false;
    }
    
    // ===== REGLAS PARA REPORTES DE MODERACIÓN =====
    match /moderation_reports/{reportId} {
      // Los usuarios pueden crear reportes
      allow create: if request.auth != null;
      
      // Solo admins pueden leer/gestionar reportes
      allow read, update: if isAdmin();
    }
    
    // ===== REGLAS PARA NOTIFICACIONES =====
    match /notifications/{notificationId} {
      // Los usuarios pueden leer sus propias notificaciones
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      
      // Los usuarios pueden marcar notificaciones como leídas
      allow update: if request.auth != null && 
        resource.data.user_id == request.auth.uid &&
        onlyUpdatingReadStatus();
      
      // Solo el sistema puede crear notificaciones
      allow create: if false;
    }
    
    // ===== REGLAS PARA LOGS DEL SISTEMA =====
    match /system_logs/{logId} {
      // Solo admins pueden leer logs
      allow read: if isAdmin();
      
      // Solo el sistema puede crear logs
      allow create, update: if false;
    }
    
    // ===== REGLAS PARA CONFIGURACIÓN DEL SISTEMA =====
    match /configuracion_sistema/{configId} {
      // Permitir lectura y escritura sin autenticación
      // NOTA: Esta página solo se accede desde el admin, no es pública
      allow read, write: if true;
    }
    
    // ===== REGLAS PARA VYT MONEY =====
    match /user_vyt_money/{userId} {
      // Los usuarios pueden leer solo su propio balance
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Solo el sistema (Cloud Functions) puede escribir
      allow write: if false;
      
      // Los admins pueden leer todos los balances
      allow read: if isAdmin();
    }
    
    // ===== FUNCIONES AUXILIARES =====
    
    // Verificar si el usuario es administrador
    function isAdmin() {
      return request.auth != null && 
        request.auth.uid != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Validar datos de usuario
    function validateUserData() {
      return request.resource.data.keys().hasAll(['email', 'firstName', 'lastName', 'userType']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.userType in ['fan', 'artist', 'artist_group'];
    }
    
    // Validar datos de inscripción online
    function validateInscripcionData() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'nombre', 'apellido', 'nombre_artista']) &&
        data.email is string &&
        data.nombre is string &&
        data.apellido is string &&
        data.nombre_artista is string &&
        data.email.size() > 0 &&
        data.nombre.size() > 0;
    }
    
    // Validar datos de voto
    function validateVoteData() {
      return request.resource.data.keys().hasAll(['voter_id', 'participante_id', 'certamen_id', 'vyt_money_spent']) &&
        request.resource.data.vyt_money_spent is number &&
        request.resource.data.vyt_money_spent > 0;
    }
    
    // Verificar que solo se está actualizando el estado de lectura
    function onlyUpdatingReadStatus() {
      return request.resource.data.diff(resource.data).affectedKeys() == ['read'].toSet();
    }
    
    // Verificar que el usuario tiene suficiente VYT-MONEY
    function hasEnoughVYTMoney(amount) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vyt_money_balance >= amount;
    }
  }
}