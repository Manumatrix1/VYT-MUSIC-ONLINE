rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== REGLAS PARA USUARIOS =====
    match /users/{userId} {
      // Lectura: usuarios propios o admins
      allow read: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());
      
      // Creación: solo el usuario puede crear su propio documento
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.role != 'admin';  // No puede autoasignarse admin
      
      // Actualización: usuarios solo sus datos, SIN TOCAR campo 'role'
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']);
      
      // Solo admins pueden cambiar roles
      allow update: if isAdmin();
    }
    
    // ===== REGLAS PARA PERFILES DE ARTISTAS =====
    match /artist_profiles/{profileId} {
      // Los artistas pueden gestionar su propio perfil
      allow read: if true; // Perfiles públicos
      allow write: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || isAdmin());
      
      // Permitir creación si es el usuario autenticado
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
        
      // Permitir lectura para usuarios autenticados
      allow read: if request.auth != null;
    }
    
    // ===== REGLAS PARA CERTÁMENES =====
    match /certamenes_provinciales/{certamenId} {
      // Lectura pública de certámenes activos
      allow read: if true;
      
      // Solo admins pueden crear/modificar certámenes
      allow write: if isAdmin();
    }

    match /certamenes_nacionales/{certamenId} {
      // Lectura pública de certámenes activos
      allow read: if true;

      // Solo admins pueden crear/modificar certámenes
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA PARTICIPANTES ONLINE =====
    match /participantes_online/{participanteId} {
      // Inscripciones requieren autenticación
      allow create: if request.auth != null && 
        validateInscripcionData() &&
        request.resource.data.uid == request.auth.uid;
      
      // Los usuarios autenticados pueden leer su propia participación
      allow read: if request.auth != null && 
        (resource.data.uid == request.auth.uid || isAdmin());
        
      // Lectura pública para listados (solo datos básicos)
      allow read: if true;
      
      // Solo admins pueden modificar participaciones
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ===== REGLAS PARA PARTICIPACIONES (SISTEMA FEDERAL - FASE 11) =====
    match /participaciones/{participacionId} {
      // Lectura pública de participaciones activas
      allow read: if true;
      
      // Los artistas pueden crear su propia participación
      allow create: if request.auth != null && 
        request.resource.data.uid == request.auth.uid;
      
      // Los artistas pueden actualizar campos propios (NO clasificación ni feedback)
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['clasificado', 'ready_for_next_round', 'feedback_jurado', 
                   'posicion_zona', 'posicion_global', 'estado']);
      
      // Solo admins pueden actualizar clasificación, feedback y estado
      allow update: if isAdmin();
      
      // Solo admins pueden eliminar
      allow delete: if isAdmin();
    }
    
    // ===== REGLAS PARA SYSTEM CONFIG (ETAPAS Y CONFIGURACIÓN FEDERAL) =====
    match /system_config/{docId} {
      // Lectura pública de configuración de etapas
      allow read: if true;
      
      // Solo admins pueden escribir configuración
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA NOTIFICACIONES (SISTEMA FEDERAL) =====
    match /notificaciones/{notificacionId} {
      // Los usuarios pueden leer solo sus propias notificaciones
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Los usuarios pueden marcar como leídas
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys() == ['leida'].toSet();
      
      // Solo admins y sistema pueden crear notificaciones
      allow create: if isAdmin();
    }
    
    // ===== REGLAS PARA HISTORIAL DE ETAPAS =====
    match /etapas_historial/{etapaId} {
      // Lectura pública del historial
      allow read: if true;
      
      // Solo admins pueden escribir
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA ESTADÍSTICAS GENERALES (JACKPOT) =====
    match /estadisticas_generales/{docId} {
      // Lectura pública
      allow read: if true;
      
      // Solo admins y sistema pueden escribir
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA TESTS (TEMPORAL) =====
    match /tests/{docId} {
      allow read, write, create, delete: if isAdmin(); // Solo admins pueden acceder
    }
    
    match /test_conexion/{docId} {
      allow create: if isAdmin(); // Solo admins pueden crear tests
    }
    
    match /test_inscripciones/{docId} {
      allow create: if isAdmin(); // Solo admins pueden crear tests
    }
    
    // ===== REGLAS PARA PARTICIPANTES PRESENCIALES =====
    match /participantes_presencial/{participanteId} {
      allow read: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || isAdmin());
      
      allow create: if request.auth != null && 
        request.resource.data.user_id == request.auth.uid;
      
      allow update: if isAdmin();
    }
    
    // ===== REGLAS PARA VOTOS =====
    match /votes/{voteId} {
      // Los usuarios pueden leer sus propios votos
      allow read: if request.auth != null && 
        resource.data.voter_id == request.auth.uid;
      
      // Los admins pueden leer todos los votos
      allow read: if isAdmin();
      
      // Los usuarios autenticados pueden crear votos
      allow create: if request.auth != null && 
        request.resource.data.voter_id == request.auth.uid &&
        validateVoteData();
      
      // Los votos no se pueden modificar
      allow update: if false;
    }
    
    // ===== REGLAS PARA TRANSACCIONES VYT-MONEY =====
    match /vyt_money_transactions/{transactionId} {
      // Los usuarios pueden leer sus propias transacciones
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      
      // Los admins pueden leer todas las transacciones
      allow read: if isAdmin();
      
      // Solo el sistema puede crear transacciones (via Cloud Functions)
      allow create: if false;
      allow update: if false;
    }
    
    // ===== REGLAS PARA TRANSACCIONES DE PAGO =====
    match /payment_transactions/{transactionId} {
      // Los usuarios pueden leer sus propias transacciones
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      
      // Los admins pueden leer todas las transacciones
      allow read: if isAdmin();
      
      // Solo el sistema puede gestionar transacciones
      allow create, update: if false;
    }
    
    // ===== REGLAS PARA CONFIGURACIÓN DE PAGOS =====
    match /payment_config/{configId} {
      // Lectura pública de configuración
      allow read: if true;
      
      // Solo admins pueden modificar configuración
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA CONFIGURACIÓN VYT-MONEY =====
    match /vyt_money_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA RANKINGS =====
    match /rankings/{rankingId} {
      // Lectura pública de rankings
      allow read: if true;
      
      // Solo el sistema puede actualizar rankings
      allow write: if false;
    }
    
    // ===== REGLAS PARA REPORTES DE MODERACIÓN =====
    match /moderation_reports/{reportId} {
      // Los usuarios pueden crear reportes
      allow create: if request.auth != null;
      
      // Solo admins pueden leer/gestionar reportes
      allow read, update: if isAdmin();
    }
    
    // ===== REGLAS PARA NOTIFICACIONES =====
    match /notifications/{notificationId} {
      // Los usuarios pueden leer sus propias notificaciones
      allow read: if request.auth != null && 
        resource.data.user_id == request.auth.uid;
      
      // Los usuarios pueden marcar notificaciones como leídas
      allow update: if request.auth != null && 
        resource.data.user_id == request.auth.uid &&
        onlyUpdatingReadStatus();
      
      // Solo el sistema puede crear notificaciones
      allow create: if false;
    }
    
    // ===== REGLAS PARA LOGS DEL SISTEMA =====
    match /system_logs/{logId} {
      // Solo admins pueden leer logs
      allow read: if isAdmin();
      
      // Solo el sistema puede crear logs
      allow create, update: if false;
    }
    
    // ===== REGLAS PARA AUDIT LOGS (NUEVO) =====
    match /audit_logs/{logId} {
      // Solo admins pueden leer audit logs
      allow read: if isAdmin();
      
      // Admins pueden crear logs (desde cliente)
      allow create: if isAdmin();
      
      // Nadie puede modificar o eliminar logs
      allow update, delete: if false;
    }
    
    // ===== REGLAS PARA CONFIGURACIÓN DEL SISTEMA =====
    match /configuracion_sistema/{configId} {
      // Lectura pública de configuración
      allow read: if true;
      
      // Solo admins pueden escribir configuración
      allow write: if isAdmin();
    }
    
    // ===== REGLAS PARA SUSCRIPCIONES DE EMAIL =====
    match /email_subscriptions/{subscriptionId} {
      // Usuarios autenticados pueden crear/actualizar su propia suscripción
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      // Usuarios pueden actualizar su propia suscripción (cambiar activo/inactivo)
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Usuarios pueden leer su propia suscripción
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Admins pueden leer todas las suscripciones
      allow read: if isAdmin();
      
      // Permitir creación anónima para emails sin login (solo email y timestamp)
      allow create: if !request.resource.data.keys().hasAny(['userId']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0;
    }
    
    // ===== REGLAS PARA VYT MONEY =====
    match /user_vyt_money/{userId} {
      // Los usuarios pueden leer solo su propio balance
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Los admins pueden leer todos los balances
      allow read: if isAdmin();
      
      // Solo el sistema (Cloud Functions) puede escribir
      allow write: if false;
      
      // Admins pueden ajustar balances manualmente (con audit log)
      allow write: if isAdmin();
    }
    
    // ===== FUNCIONES AUXILIARES =====
    
    // Verificar si el usuario es administrador
    function isAdmin() {
      return request.auth != null && 
        request.auth.uid != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Validar datos de usuario
    function validateUserData() {
      return request.resource.data.keys().hasAll(['email', 'firstName', 'lastName', 'userType']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.userType in ['fan', 'artist', 'artist_group'];
    }
    
    // Validar datos de inscripción online
    function validateInscripcionData() {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'nombre_artista', 'estado']) &&
        data.email is string &&
        data.email.matches('.*@.*\\..*') &&
        data.nombre_artista is string &&
        data.nombre_artista.size() >= 2 &&
        data.estado in ['pendiente', 'aprobado', 'rechazado', 'aprobado_pendiente_pago'] &&
        (!data.keys().hasAny(['certamen_id']) || 
         (data.certamen_id is string && data.certamen_id.size() > 0));
    }
    
    // Validar datos de voto
    function validateVoteData() {
      return request.resource.data.keys().hasAll(['voter_id', 'participante_id', 'certamen_id', 'vyt_money_spent']) &&
        request.resource.data.vyt_money_spent is number &&
        request.resource.data.vyt_money_spent > 0;
    }
    
    // Verificar que solo se está actualizando el estado de lectura
    function onlyUpdatingReadStatus() {
      return request.resource.data.diff(resource.data).affectedKeys() == ['read'].toSet();
    }
    
    // Verificar que el usuario tiene suficiente VYT-MONEY
    function hasEnoughVYTMoney(amount) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vyt_money_balance >= amount;
    }
  }
}