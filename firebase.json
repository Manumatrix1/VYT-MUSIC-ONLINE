{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/administrador",
        "destination": "/admin.html"
      },
      {
        "source": "/panel",
        "destination": "/admin.html"
      },
      {
        "source": "/recibirPago",
        "function": "recibirNotificacionPago"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}