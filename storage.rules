rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reglas para fotos de perfil (nueva ruta) - TEMPORALMENTE ABIERTO PARA TESTING
    match /perfiles/{fileName} {
      allow read: if true; // Las fotos de perfil son públicas
      allow write: if true; // TEMPORAL: permitir sin auth para testing
                   // TODO: Cambiar a: request.auth != null cuando auth esté funcionando
                   // && request.resource.size < 5 * 1024 * 1024 
                   // && request.resource.contentType.matches('image/.*');
    }
    
    // Reglas para fotos de perfil (ruta legacy)
    match /profile-photos/{artistId} {
      allow read: if true; // Las fotos de perfil son públicas
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024 // 5MB máximo
                   && request.resource.contentType.matches('image/.*'); // Solo imágenes
    }
    
    // Reglas para videos de artistas
    match /videos/{fileName} {
      allow read: if true; // Los videos son públicos
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024 // 100MB máximo
                   && request.resource.contentType.matches('video/.*'); // Solo videos
    }
    
    // Reglas para fondos de páginas (ADMIN)
    match /fondos/{fileName} {
      allow read: if true; // Los fondos son públicos
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024 // 5MB máximo
                   && request.resource.contentType.matches('image/.*'); // Solo imágenes
    }
    
    // Reglas para archivos de prueba
    match /tests/{allPaths=**} {
      allow read, write: if true; // Para testing, permitir todo
    }
    
    // Reglas para videos de certámenes (legacy)
    match /certamen-videos/{artistId}/{videoId} {
      allow read: if true; // Los videos son públicos
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024 // 100MB máximo
                   && request.resource.contentType.matches('video/.*'); // Solo videos
    }
    
    // Denegar todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}